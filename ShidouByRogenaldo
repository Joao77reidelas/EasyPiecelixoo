local function animateCooldown(fillFrame)
    if not fillFrame then 
        warn("⚠️ Fill não encontrado!")
        return 
    end
    
    print("✅ Fill encontrado, iniciando animação...")
    
    fillFrame.Size = UDim2.new(1, 0, 0, 0)
    fillFrame.Visible = true
    fillFrame.Size = UDim2.new(1, 0, 0, 60)
    
    local tweenInfo = TweenInfo.new(
        KICK_COOLDOWN,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut
    )
    
    local tween = TweenService:Create(fillFrame, tweenInfo, {
        Size = UDim2.new(1, 0, 0, 0)
    })
    
    tween:Play()
    print("🔄 Cooldown visual ativado!")
end

-- === FUNÇÃO PRINCIPAL DO BIG BANG ===
local function executeBigBang()
    print("💥 Função executeBigBang() chamada!")
    
    if isKicking or isOnCooldown then
        print("⏳ Aguarde o cooldown terminar!")
        return
    end
    
    if not playerHasBall() then
        print("🚫 Você precisa ter a bola!")
        showMessage("Must Have The Ball", 1.5)
        return
    end
    
    local character = player.Character
    if not character then 
        warn("❌ Character não encontrado!")
        return 
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not root or not humanoid then 
        warn("❌ HumanoidRootPart ou Humanoid não encontrado!")
        return 
    end
    
    isKicking = true
    isOnCooldown = true
    
    print("✅ Big Bang iniciado!")
    
    local animator = humanoid:FindFirstChild("Animator") or humanoid:WaitForChild("Animator", 5)
    if not animator then
        isKicking = false
        isOnCooldown = false
        return
    end
    
    local originalWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 0
    
    -- Animação inicial
    local goatFlipAnim = ReplicatedStorage:WaitForChild("Anims"):WaitForChild("Ronaldo"):WaitForChild("GoatFlipsStart")
    local goatFlipTrack = animator:LoadAnimation(goatFlipAnim)
    goatFlipTrack:Play()
    goatFlipTrack:AdjustSpeed(0.5)
    
    task.wait(1)
    goatFlipTrack:Stop()
    
    -- Sobe
    local upVelocity = UP_DISTANCE / UP_TIME
    local bvUp = Instance.new("BodyVelocity")
    bvUp.MaxForce = Vector3.new(0, math.huge, 0)
    bvUp.Velocity = Vector3.new(0, upVelocity, 0)
    bvUp.Parent = root
    
    -- Animação no ar
    local airAnim = ReplicatedStorage:WaitForChild("CutsceneAnimations"):WaitForChild("Beinschuss"):WaitForChild("Animation")
    local airTrack = animator:LoadAnimation(airAnim)
    airTrack:Play()
    airTrack:AdjustSpeed(2)
    
    task.wait(UP_TIME)
    
    if bvUp then bvUp:Destroy() end
    
    -- Para no ar
    local bvHold = Instance.new("BodyVelocity")
    bvHold.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bvHold.Velocity = Vector3.new(0, 0, 0)
    bvHold.Parent = root
    
    -- Cria asas magenta
    createMagentaWings(character)
    
    task.wait(AIR_HOLD_TIME)
    
    -- CHUTE
    if playerHasBall() then
        local camera = workspace.CurrentCamera
        local kickDirection = camera.CFrame.LookVector.Unit
        playKickSound()
        
        local shootEvent = ReplicatedStorage:FindFirstChild("Events")
        if shootEvent then
            shootEvent = shootEvent:FindFirstChild("ShootBall")
            if shootEvent then
                shootEvent:FireServer(kickDirection, KICK_FORCE)
                print("⚽ Bola chutada!")
                
                task.delay(0.1, function()
                    local ballInWorld = workspace:FindFirstChild("Ball") or 
                                      workspace:FindFirstChild("SoccerBall") or 
                                      workspace:FindFirstChild("Football")
                    if ballInWorld and ballInWorld:IsA("BasePart") then
                        createPinkTrail(ballInWorld)
                        print("✨ Efeitos rosa adicionados à bola!")
                    end
                end)
            end
        end
    end
    
    task.wait(0.3)
    
    if airTrack then airTrack:Stop() end
    if bvHold then bvHold:Destroy() end
    
    humanoid.WalkSpeed = originalWalkSpeed
    isKicking = false
    
    -- Cooldown visual na Hotbar
    local hotbar = playerGui:FindFirstChild("Hotbar")
    if hotbar then
        print("✅ Hotbar encontrada!")
        local container = hotbar:FindFirstChild("Container")
        if container then
            print("✅ Container encontrado!")
            for _, holder in ipairs(container:GetChildren()) do
                if holder:IsA("Frame") and holder.Name == "Holder" then
                    local widget = holder:FindFirstChild("Widget")
                    if widget then
                        local label = widget:FindFirstChild("Label")
                        
                        if label and label:IsA("TextLabel") then
                            print("🔍 Label encontrado com texto: '" .. label.Text .. "'")
                            
                            if label.Text == "3" then
                                print("✅ Holder com Label '3' encontrado!")
                                
                                local fill = widget:FindFirstChild("Fill")
                                if fill then
                                    print("✅ Fill encontrado no Holder correto!")
                                    animateCooldown(fill)
                                    break
                                else
                                    warn("❌ Fill não encontrado no Widget do Holder '3'!")
                                end
                            end
                        end
                    end
                end
            end
        else
            warn("❌ Container não encontrado!")
        end
    else
        warn("❌ Hotbar não encontrada!")
    end
    
    task.wait(KICK_COOLDOWN)
    isOnCooldown = false
    
    print("✅ Big Bang pronto para usar novamente!")
end

-- === PROCURA E SUBSTITUI O BOTÃO NA HOTBAR ===
local function setupHotbarButton()
    print("🔍 Procurando Hotbar...")
    
    local hotbar = playerGui:WaitForChild("Hotbar", 10)
    if not hotbar then
        warn("❌ Hotbar não encontrada após 10 segundos!")
        return
    end
    
    print("✅ Hotbar encontrada!")
    
    local container = hotbar:WaitForChild("Container", 10)
    if not container then
        warn("❌ Container não encontrado!")
        return
    end
    
    print("✅ Container encontrado!")
    print("🔍 Holders no Container:")
    
    for _, holder in ipairs(container:GetChildren()) do
        if holder:IsA("Frame") and holder.Name == "Holder" then
            local widget = holder:FindFirstChild("Widget")
            if widget then
                local label = widget:FindFirstChild("Label")
                
                if label and label:IsA("TextLabel") then
                    print("   - Holder com Label: '" .. label.Text .. "'")
                    
                    if label.Text == "3" then
                        print("✅ Holder com Label '3' ENCONTRADO!")
                        
                        local oldButton = widget:FindFirstChild("TextButton")
                        local oldBottomText = widget:FindFirstChild("BottomText")
                        local oldLabel = widget:FindFirstChild("Label")
                        
                        if oldButton then
                            print("✅ Botão antigo encontrado, substituindo...")
                            
                            local bottomTextClone = oldBottomText and oldBottomText:Clone()
                            local labelClone = oldLabel and oldLabel:Clone()
                            
                            local newButton = oldButton:Clone()
                            newButton.Name = "TB"
                            newButton.Text = "Big Bang"
                            
                            oldButton:Destroy()
                            if oldBottomText then oldBottomText:Destroy() end
                            if oldLabel then oldLabel:Destroy() end
                            
                            newButton.Parent = widget
                            
                            if bottomTextClone then
                                bottomTextClone.Text = "Ball"
                                bottomTextClone.Parent = widget
                            end
                            
                            if labelClone then
                                labelClone.Text = "3"
                                labelClone.Parent = widget
                            end
                            
                            newButton.MouseButton1Click:Connect(executeBigBang)
                            
                            print("✅✅✅ Botão Big Bang configurado com sucesso no slot 3!")
                            return
                        else
                            warn("❌ TextButton não encontrado no Widget!")
                        end
                    end
                end
            end
        end
    end
    
    warn("⚠️ Não foi possível encontrar o Holder com Label '3'")
end

-- Aguarda o personagem carregar antes de configurar
player.CharacterAdded:Connect(function()
    print("👤 Personagem carregado, configurando botão...")
    setupHotbarButton()
end)

