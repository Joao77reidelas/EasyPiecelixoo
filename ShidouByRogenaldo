-- === FUNÇÃO PARA INCLINAR O PERSONAGEM PRA FRENTE ===
local function applyDiveRotation(root)
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.P = 10000
    bodyGyro.D = 500
    
    local forwardDirection = root.CFrame.LookVector
    
    local tiltedCFrame = CFrame.lookAt(
        root.Position,
        root.Position + forwardDirection
    ) * CFrame.Angles(math.rad(DIVE_ANGLE), 0, 0)
    
    bodyGyro.CFrame = tiltedCFrame
    bodyGyro.Parent = root
    
    print("🔄 Rotação de mergulho aplicada!")
    return bodyGyro
end

