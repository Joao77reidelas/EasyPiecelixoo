            local widget = holder:FindFirstChild("Widget")
            if widget then
                local label = widget:FindFirstChild("Label")
                
                if label and label:IsA("TextLabel") then
                    print("   - Holder com Label: '" .. label.Text .. "'")
                    
                    if label.Text == "1" then
                        print("✅ Holder com Label '1' ENCONTRADO!")
                        
