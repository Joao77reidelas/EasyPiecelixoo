-- === FUNÇÃO PARA CRIAR ASAS MAGENTA NO JOGADOR ===
local function createMagentaWings(character)
    if not character then return end
    
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if not torso then return end
    
    local wingsFolder = Instance.new("Folder")
    wingsFolder.Name = "MagentaWings"
    wingsFolder.Parent = character
    
    local wingConfig = {
        length = 8,
        width = 4,
        segments = 8,
        spread = 45
    }
    
    local function createWing(side)
        local sideMultiplier = side == "Left" and -1 or 1
        
        for i = 1, wingConfig.segments do
            local segment = Instance.new("Part")
            segment.Name = side .. "WingSegment" .. i
            segment.Size = Vector3.new(0.3, wingConfig.width * (1 - i/wingConfig.segments * 0.3), wingConfig.length / wingConfig.segments)
            segment.Material = Enum.Material.Neon
            segment.CanCollide = false
            segment.Anchored = true
            segment.Transparency = 0.2
            segment.Massless = true
            
            local colorValue = 1 - (i / wingConfig.segments * 0.4)
            segment.Color = Color3.fromRGB(255 * colorValue, 50 * colorValue, 255 * colorValue)
            
            local offset = i / wingConfig.segments
            local angle = math.rad(wingConfig.spread * offset)
            local xOffset = sideMultiplier * (2 + offset * 5)
            local yOffset = -offset * 2
            local zOffset = math.sin(angle) * 2
            
            segment.CFrame = torso.CFrame * CFrame.new(xOffset, yOffset, zOffset) * CFrame.Angles(0, sideMultiplier * angle, math.rad(sideMultiplier * 15))
            segment.Parent = wingsFolder
            
            local att0 = Instance.new("Attachment")
            att0.Position = Vector3.new(0, segment.Size.Y/2, 0)
            att0.Parent = segment
            
            local att1 = Instance.new("Attachment")
            att1.Position = Vector3.new(0, -segment.Size.Y/2, 0)
            att1.Parent = segment
            
            local trail = Instance.new("Trail")
            trail.Attachment0 = att0
            trail.Attachment1 = att1
            trail.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 255)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 50, 200)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 0, 100))
            })
            trail.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.4),
                NumberSequenceKeypoint.new(1, 1)
            })
            trail.Lifetime = 0.5
            trail.MinLength = 0.1
            trail.LightEmission = 1
            trail.Parent = segment
            
            local particles = Instance.new("ParticleEmitter")
            particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
            particles.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 50, 200))
            })
            particles.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.3),
                NumberSequenceKeypoint.new(1, 1)
            })
            particles.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 0)
            })
            particles.Lifetime = NumberRange.new(0.3, 0.6)
            particles.Rate = 30
            particles.Speed = NumberRange.new(2, 5)
            particles.SpreadAngle = Vector2.new(30, 30)
            particles.LightEmission = 1
            particles.Parent = segment
            
            local smoke = Instance.new("ParticleEmitter")
            smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
            smoke.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 50, 180)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 0, 100))
            })
            smoke.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.6),
                NumberSequenceKeypoint.new(1, 1)
            })
            smoke.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.8),
                NumberSequenceKeypoint.new(1, 2)
            })
            smoke.Lifetime = NumberRange.new(0.4, 0.8)
            smoke.Rate = 20
            smoke.Speed = NumberRange.new(1, 3)
            smoke.SpreadAngle = Vector2.new(40, 40)
            smoke.LightEmission = 0.4
            smoke.Parent = segment
        end
    end
    
    createWing("Left")
    createWing("Right")
    
    task.spawn(function()
        local duration = 2.5
        local startTime = tick()
        
        while tick() - startTime < duration do
            if not torso or not torso.Parent then break end
            
            for _, segment in ipairs(wingsFolder:GetChildren()) do
                if segment:IsA("BasePart") then
                    local wobble = math.sin(tick() * 8) * 0.05
                    
                    local segmentIndex = tonumber(segment.Name:match("%d+"))
                    local side = segment.Name:match("Left") and "Left" or "Right"
                    local sideMultiplier = side == "Left" and -1 or 1
                    
                    local offset = segmentIndex / wingConfig.segments
                    local angle = math.rad(wingConfig.spread * offset)
                    local xOffset = sideMultiplier * (2 + offset * 5)
                    local yOffset = -offset * 2
                    local zOffset = math.sin(angle) * 2
                    
                    segment.CFrame = torso.CFrame * CFrame.new(xOffset, yOffset, zOffset) * CFrame.Angles(wobble, sideMultiplier * angle, math.rad(sideMultiplier * 15))
                end
            end
            task.wait(0.03)
        end
        
        for _, segment in ipairs(wingsFolder:GetChildren()) do
            if segment:IsA("BasePart") then
                TweenService:Create(segment, TweenInfo.new(0.5), {Transparency = 1}):Play()
            end
        end
        
        task.wait(0.5)
        wingsFolder:Destroy()
    end)
end

