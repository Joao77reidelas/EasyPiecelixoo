-- === FUNÇÃO PARA MOSTRAR MENSAGEM ===
local function showMessage(message, duration)
    local messagesEvent = ReplicatedStorage:FindFirstChild("Events")
    if messagesEvent then
        messagesEvent = messagesEvent:FindFirstChild("Messages")
        if messagesEvent then
            local sendMessage = messagesEvent:FindFirstChild("SendMessage")
            if sendMessage then
                firesignal(sendMessage.OnClientEvent, message, duration)
                print("📢 Mensagem enviada: " .. message)
            end
        end
    end
end

-- === FUNÇÃO PARA VERIFICAR SE O JOGADOR TEM A BOLA ===
local function playerHasBall()
    local playerFolder = workspace:FindFirstChild(player.Name)
    
    if not playerFolder then
        print("❌ Pasta do LocalPlayer não encontrada no Workspace!")
        return false
    end
    
    local ball = playerFolder:FindFirstChild("Ball")
    
    if ball then
        print("✅ LocalPlayer possui a bola!")
        return true
    else
        print("❌ LocalPlayer NÃO possui a bola!")
