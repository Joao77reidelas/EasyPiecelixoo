    print("🔄 Cooldown visual ativado!")
end

-- === FUNÇÃO DO DRAGON DRIVE ===
local function dragonDrive()
    print("🐉 Função dragonDrive() chamada!")
    
    if isKicking or isOnCooldown then
        print("⏳ Aguarde o cooldown terminar!")
        return
    end
    
    if not playerHasBall() then
        print("🚫 Você precisa ter a bola!")
        showMessage("Must Have The Ball", 1.5)
        return
    end
    
    local character = player.Character
    if not character then 
        warn("❌ Character não encontrado!")
        return 
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoidRootPart or not humanoid then 
        warn("❌ HumanoidRootPart ou Humanoid não encontrado!")
        return 
    end
    
    isKicking = true
    isOnCooldown = true
    
    print("✅ Dragon Drive iniciado!")
    
    -- Toca animação
    local animTrack = nil
    local animator = humanoid:FindFirstChild("Animator")
    if animator then
        local animObj = ReplicatedStorage:WaitForChild("Anims"):WaitForChild("SU"):WaitForChild("StandFloat")
        animTrack = animator:LoadAnimation(animObj)
        animTrack:Play()
    end
    
    -- Som de subida
    playRiseSound()
    
    -- Efeito no jogador
    local playerEffect = addSaeEffectToPlayer(character)
    
    -- Congela
    local originalWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 0
    
    -- Sobe
    local upVelocity = UP_DISTANCE / UP_TIME
    local bvUp = Instance.new("BodyVelocity")
    bvUp.MaxForce = Vector3.new(0, math.huge, 0)
    bvUp.Velocity = Vector3.new(0, upVelocity, 0)
    bvUp.Parent = humanoidRootPart
    
    task.delay(UP_TIME, function()
        if bvUp then bvUp:Destroy() end
        
        -- Remove efeito do jogador com fade suave
        if playerEffect and playerEffect.Parent then
            local fadeDuration = 0.4
            local fadeSteps = 20
            local fadeInterval = fadeDuration / fadeSteps
            
            task.spawn(function()
                for i = 1, fadeSteps do
                    if playerEffect and playerEffect.Parent then
                        playerEffect.Transparency = i / fadeSteps
                        
                        for _, descendant in pairs(playerEffect:GetDescendants()) do
                            if descendant:IsA("BasePart") or descendant:IsA("MeshPart") then
                                descendant.Transparency = i / fadeSteps
                            elseif descendant:IsA("ParticleEmitter") then
                                descendant.Transparency = NumberSequence.new(i / fadeSteps)
                            elseif descendant:IsA("Beam") or descendant:IsA("Trail") then
                                descendant.Transparency = NumberSequence.new(i / fadeSteps)
                            end
                        end
                        
                        task.wait(fadeInterval)
                    else
                        break
                    end
                end
                
                if playerEffect and playerEffect.Parent then
                    playerEffect:Destroy()
                    print("🗑️ Efeito removido do jogador com fade!")
                end
            end)
        end
        
        -- Para no ar
        local bvHold = Instance.new("BodyVelocity")
        bvHold.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bvHold.Velocity = Vector3.new(0, 0, 0)
        bvHold.Parent = humanoidRootPart
        
        -- Som de chute
        task.delay(KICK_DELAY - 0.5, function()
            playKickSound()
        end)
        
        task.wait(KICK_DELAY)
        
        if playerHasBall() then
            local camera = workspace.CurrentCamera
            local kickDirection = camera.CFrame.LookVector.Unit
            
            local shootEvent = ReplicatedStorage:FindFirstChild("Events")
            if shootEvent then
                shootEvent = shootEvent:FindFirstChild("ShootBall")
                if shootEvent then
                    shootEvent:FireServer(kickDirection, KICK_FORCE)
                    print("⚽ Bola chutada!")
                    
                    -- Efeito na bola
                    task.delay(0.1, function()
                        local ballInWorld = workspace:FindFirstChild("Ball") or workspace:FindFirstChild("SoccerBall")
                        if ballInWorld then
                            addSaeEffect(ballInWorld)
                        end
                    end)
                end
            end
        end
        
        task.delay(FLOAT_HOLD_TIME, function()
            if animTrack then animTrack:Stop() end
            
            if bvHold then bvHold:Destroy() end
            humanoid.WalkSpeed = originalWalkSpeed
            isKicking = false
        end)
    end)
    
    -- Cooldown visual na Hotbar
    local hotbar = playerGui:FindFirstChild("Hotbar")
    if hotbar then
        print("✅ Hotbar encontrada!")
        local container = hotbar:FindFirstChild("Container")
        if container then
            print("✅ Container encontrado!")
            for _, holder in ipairs(container:GetChildren()) do
                if holder:IsA("Frame") and holder.Name == "Holder" then
                    local widget = holder:FindFirstChild("Widget")
                    if widget then
                        local label = widget:FindFirstChild("Label")
                        
                        if label and label:IsA("TextLabel") then
                            print("🔍 Label encontrado com texto: '" .. label.Text .. "'")
                            
                            if label.Text == "1" then
                                print("✅ Holder com Label '1' encontrado!")
                                
                                local fill = widget:FindFirstChild("Fill")
                                if fill then
                                    print("✅ Fill encontrado no Holder correto!")
                                    animateCooldown(fill)
                                    break
                                else
                                    warn("❌ Fill não encontrado no Widget do Holder '1'!")
                                end
                            end
                        end
                    end
                end
            end
        else
            warn("❌ Container não encontrado!")
        end
    else
        warn("❌ Hotbar não encontrada!")
    end
    
    task.wait(KICK_COOLDOWN)
    isOnCooldown = false
    
    print("✅ Dragon Drive pronto para usar novamente!")
end

