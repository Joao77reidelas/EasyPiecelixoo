-- === FUNÇÃO PRINCIPAL DO DRAGON HEADER ===
local function executeDragonHeader()
    print("🐉 Função executeDragonHeader() chamada!")
    
    if isExecuting or isOnCooldown then
        print("⏳ Aguarde o cooldown terminar!")
        return
    end
    
    if not playerHasBall() then
        print("🚫 Você precisa ter a bola!")
        showMessage("Must Have The Ball", 1.5)
        return
    end
    
    local character = player.Character
    if not character then 
        warn("❌ Character não encontrado!")
        return 
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not root or not humanoid then 
        warn("❌ HumanoidRootPart ou Humanoid não encontrado!")
        return 
    end
    
    isExecuting = true
    isOnCooldown = true
    
    print("✅ Dragon Header iniciado!")
    
    local animator = humanoid:FindFirstChild("Animator") or humanoid:WaitForChild("Animator", 5)
    if not animator then
        isExecuting = false
        isOnCooldown = false
        return
    end
    
    -- Salva e desativa ShiftLock temporariamente
    local wasShiftLockEnabled = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
    local cameraModule = nil
    local originalAutoRotate = humanoid.AutoRotate
    
    humanoid.AutoRotate = false
    
    pcall(function()
        local playerScripts = player:WaitForChild("PlayerScripts", 1)
        if playerScripts then
            local playerModule = playerScripts:FindFirstChild("PlayerModule")
            if playerModule then
                cameraModule = require(playerModule:WaitForChild("CameraModule"))
                if cameraModule and wasShiftLockEnabled then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                    print("🔓 ShiftLock desativado temporariamente!")
                end
            end
        end
    end)
    
    local originalWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 0
    
    local originalState = humanoid:GetState()
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    -- EFEITO NO JOGADOR
    local playerEffect = addSaeEffectToPlayer(character)
    
    -- EFEITO NA BOLA (ENQUANTO NO JOGADOR)
    local ballEffect = addSaeEffectToBallInPlayer()
    
    -- Animação RainbowFlick
    print("🌈 RainbowFlick iniciado!")
    local rainbowAnim = ReplicatedStorage:WaitForChild("Anims"):WaitForChild("RainbowFlick")
    local animTrack = animator:LoadAnimation(rainbowAnim)
    animTrack:Play()
    
    task.wait(0.1)
    
    -- Aplica rotação de mergulho
    local bodyGyro = applyDiveRotation(root)
    
    -- Impulso pra frente e pra cima
    local forwardDirection = root.CFrame.LookVector
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = (forwardDirection * FORWARD_FORCE) + Vector3.new(0, 20, 0)
    bodyVel.Parent = root
    
