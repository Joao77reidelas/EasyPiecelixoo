-- === FUNÇÃO PARA ANIMAR O COOLDOWN VISUAL ===
local function animateCooldown(fillFrame)
    if not fillFrame then 
        warn("⚠️ Fill não encontrado!")
        return 
    end
    
    print("✅ Fill encontrado, iniciando animação...")
    
    fillFrame.Size = UDim2.new(1, 0, 0, 0)
    fillFrame.Visible = true
    fillFrame.Size = UDim2.new(1, 0, 0, 60)
    
    local tweenInfo = TweenInfo.new(
        KICK_COOLDOWN,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut
    )
    
