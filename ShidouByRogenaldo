-- === FUNÇÃO PARA ADICIONAR EFEITO SAE NA BOLA ===
local function addSaeEffect(ball)
    if not ball or not ball:IsA("BasePart") then return end
    
    local vfxFolder = ReplicatedStorage:FindFirstChild("VFX")
    if not vfxFolder then return end
    
    local saeEffect = vfxFolder:FindFirstChild("SaeCurvedShot")
    if not saeEffect then return end
    
    local effectClone = saeEffect:Clone()
    effectClone.CanCollide = false
    effectClone.Anchored = false
    effectClone.Massless = true
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = ball
    weld.Part1 = effectClone
    weld.Parent = effectClone
    
    effectClone.CFrame = ball.CFrame
    effectClone.Parent = ball
    
    print("✨ Efeito adicionado à bola!")
    
    task.delay(1, function()
        if effectClone and effectClone.Parent then
            effectClone:Destroy()
        end
    end)
end

